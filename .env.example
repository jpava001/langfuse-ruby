# ================================
# LangFuse configuration
# ================================

LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# Environment label shown in LangFuse
LANGFUSE_ENVIRONMENT=local

# Optional identity overrides
LANGFUSE_USER_ID=example-user-123
# LANGFUSE_SESSION_ID=optional-fixed-session-id


# ================================
# OpenTelemetry
# ================================

# LangFuse OTLP HTTP endpoint
OTEL_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces


# ================================
# AWS / Bedrock
# ================================

AWS_REGION=us-east-1

# Claude model enabled in your Bedrock account
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ================================
# Cost estimation (examples only)
# ================================

USD_PER_1K_INPUT_TOKENS=0.003
USD_PER_1K_OUTPUT_TOKENS=0.015

OTEL_EXPORTER_OTLP_COMPRESSION=none
